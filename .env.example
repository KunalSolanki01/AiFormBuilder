# ───────────── Server (server/.env) ─────────────
# Copy this file to server/.env and fill in the values.
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins
CLIENT_URL=http://localhost:5173

# Supabase project settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Groq — server-only. NEVER prefix with VITE_.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Optional — enables "Verify email with Google" on email questions.
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Add your site (e.g. http://localhost:5173 and your production URL) under Authorized JavaScript origins.
# This is a public identifier, not a secret.
GOOGLE_CLIENT_ID=

# ───────────── Client (client/.env) ─────────────
# Only needed in production when the API is on a different origin.
# In development Vite proxies /api to http://localhost:4000.
# VITE_API_URL=https://your-api.onrender.com
